NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PUBLIC_APP_URL=http://localhost:3000

# Use "mock" only for local UI development. Production uses openai.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
CRON_SECRET=

RESEND_API_KEY=
EMAIL_FROM=Lemeri AI <noreply@example.com>

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe prices: Starter $19/month, Custom $29/month (legacy STRIPE_START_PRICE_ID / STRIPE_GROWTH_PRICE_ID still work)
STRIPE_STARTER_PRICE_ID=
STRIPE_CUSTOM_PRICE_ID=
STRIPE_STARTER_YEARLY_PRICE_ID=
STRIPE_CUSTOM_YEARLY_PRICE_ID=
# AI reply allowance per period (see docs/CLAUDE_CONTEXT.md, «Лимиты и экономика»)
LEMIRI_LIMIT_TRIAL_MESSAGES=150
LEMIRI_LIMIT_STARTER_MESSAGES=1000
LEMIRI_LIMIT_CUSTOM_MESSAGES=2000
# Trials of accounts created before this date start on it (ISO date)
LEMIRI_TRIAL_EPOCH=2026-10-10T00:00:00Z
# Workspace ids with complimentary Custom access (comma separated)
LEMIRI_COMP_WORKSPACES=
# Lemeri platform admins (comma separated): «Админка», workspace «Lemeri AI» set up without onboarding
LEMIRI_ADMIN_EMAILS=
# Testing period: everyone gets the full Custom plan for free, checkout is disabled.
# Remove (or set to 0) to turn plans and payments back on. Data is untouched.
LEMIRI_OPEN_ACCESS=
# Deferred modules to switch on (docs/FUTURE_FEATURES.md): crm,team,messengers,integrations,automations,appointments,actionsPage,analyticsPro,workspaceAssistant,multiWorkspace
LEMIRI_FEATURES=

WHATSAPP_GRAPH_VERSION=v22.0

# Payments: P2P transfers, confirmed by a platform admin (default).
# BILLING_PROVIDER=stripe switches to Stripe. Set real values as Cloudflare Secrets, never here.
# Recipient name shown on the checkout page, e.g. a first name
LEMIRI_P2P_RECIPIENT=
# Transfer details, one per line, separated by | (bank, account/phone, etc.)
LEMIRI_P2P_DETAILS=
# Currency of the transfer (default USD) and the rate from USD prices (default 1)
LEMIRI_P2P_CURRENCY=
LEMIRI_P2P_RATE=
# Optional extra line on the checkout page
LEMIRI_P2P_NOTE=
# Crypto: USDT on TRON (TRC-20), confirmed automatically on-chain. Public wallet address (starts with T)
LEMIRI_CRYPTO_USDT_TRC20=
# Optional TronGrid API key (trongrid.io) for a higher rate limit
LEMIRI_TRONGRID_KEY=

# Legal pages (/legal/terms, /legal/privacy, /legal/refund) show the brand «Lemeri AI» and this email only
LEMIRI_SUPPORT_EMAIL=
