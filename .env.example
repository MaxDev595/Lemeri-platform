NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PUBLIC_APP_URL=http://localhost:3000

# Use "mock" only for local UI development. Production supports groq or openai.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
CRON_SECRET=

RESEND_API_KEY=
EMAIL_FROM=Lemeri AI <noreply@example.com>

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe prices: Starter $19/month, Custom $29/month (legacy STRIPE_START_PRICE_ID / STRIPE_GROWTH_PRICE_ID still work)
STRIPE_STARTER_PRICE_ID=
STRIPE_CUSTOM_PRICE_ID=
STRIPE_STARTER_YEARLY_PRICE_ID=
STRIPE_CUSTOM_YEARLY_PRICE_ID=
# AI reply allowance per period (see docs/CLAUDE_CONTEXT.md, «Лимиты и экономика»)
LEMIRI_LIMIT_TRIAL_MESSAGES=150
LEMIRI_LIMIT_STARTER_MESSAGES=2000
LEMIRI_LIMIT_CUSTOM_MESSAGES=2000
# Trials of accounts created before this date start on it (ISO date)
LEMIRI_TRIAL_EPOCH=2026-10-10T00:00:00Z
# Workspace ids with complimentary Custom access (comma separated)
LEMIRI_COMP_WORKSPACES=
# Testing period: everyone gets the full Custom plan for free, checkout is disabled.
# Remove (or set to 0) to turn plans and payments back on. Data is untouched.
LEMIRI_OPEN_ACCESS=
# Deferred modules to switch on (docs/FUTURE_FEATURES.md): crm,team,messengers,integrations,automations,appointments,actionsPage,analyticsPro,workspaceAssistant,multiWorkspace
LEMIRI_FEATURES=

WHATSAPP_GRAPH_VERSION=v22.0

# Payments: Paddle (default). BILLING_PROVIDER=stripe switches back to Stripe.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# Monthly prices ($19 / $29) — required
PADDLE_STARTER_PRICE_ID=
PADDLE_CUSTOM_PRICE_ID=
# Yearly prices, 20% off ($182.40 / $278.40) — optional; the "Yearly" option works once both are set
PADDLE_STARTER_YEARLY_PRICE_ID=
PADDLE_CUSTOM_YEARLY_PRICE_ID=

# Legal pages (/legal/terms, /legal/privacy, /legal/refund)
LEMIRI_LEGAL_ENTITY=
LEMIRI_LEGAL_ID=
LEMIRI_LEGAL_ADDRESS=
LEMIRI_LEGAL_COUNTRY=
LEMIRI_SUPPORT_EMAIL=
