NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PUBLIC_APP_URL=http://localhost:3000

# Use "mock" only for local UI development. Production supports groq or openai.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
CRON_SECRET=

RESEND_API_KEY=
EMAIL_FROM=Lemiri AI <noreply@example.com>

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe prices: Starter $19/month, Custom $29/month (legacy STRIPE_START_PRICE_ID / STRIPE_GROWTH_PRICE_ID still work)
STRIPE_STARTER_PRICE_ID=
STRIPE_CUSTOM_PRICE_ID=
# AI reply allowance per period (see docs/CLAUDE_CONTEXT.md, «Лимиты и экономика»)
LEMIRI_LIMIT_TRIAL_MESSAGES=150
LEMIRI_LIMIT_STARTER_MESSAGES=2000
LEMIRI_LIMIT_CUSTOM_MESSAGES=2000
# Trials of accounts created before this date start on it (ISO date)
LEMIRI_TRIAL_EPOCH=2026-10-10T00:00:00Z
# Workspace ids with complimentary Custom access (comma separated)
LEMIRI_COMP_WORKSPACES=
# Deferred modules to switch on (docs/FUTURE_FEATURES.md): crm,team,messengers,integrations,automations,appointments,actionsPage,analyticsPro,workspaceAssistant,multiWorkspace
LEMIRI_FEATURES=

WHATSAPP_GRAPH_VERSION=v22.0
